{
    "version": "20250623.14",
    "include": [
        {
            "url": "https://raw.githubusercontent.com/antmicro/kenning-pipeline-manager/main/examples/sample-specification.json",
            "style": [
                "import",
                "miscellaneous"
            ]
        },
        "https://raw.githubusercontent.com/antmicro/kenning-pipeline-manager/main/examples/sample-loopback-specification.json",
        "https://raw.githubusercontent.com/antmicro/kenning-pipeline-manager/main/examples/sample-multiple-io-specification.json"
    ],
    "nodes": [
        {
            "name": "UploadVideo",
            "category": "Filesystem",
            "properties": [
                {"name": "Platform", "type": "text", "default": ""},
                {"name": "API Token", "type": "text", "default": ""}
            ],
            "interfaces": [
                {"name": "frames", "type": ["Image", "BinaryImage"], "direction": "input"}
            ],
            "style": "miscellaneous"
        }
    ],
    "metadata": {
        "styles": {
            "import": {
                "icon": "Import",
                "pill": {"text": "Import", "color": "#ffffff"}
            },
            "miscellaneous": {
                "color": "#000000",
                "pill": {"text": "misc", "color": "#2271b3"}
            }
        },
        "nodeLists": {
            "All Nodes": ".",
            "Custom Nodes": "[.[] | select(.tag? == \"custom\")]",
            "Video Nodes": "[.[] | select(.name? | contains(\"Video\"))]",
            "Frame Nodes": "[.[] | select(.name? | contains(\"Frame\"))]",
            "Save Nodes": "[.[] | select(.name? | contains(\"Save\"))]",
            "Load Nodes": "[.[] | select(.name? | contains(\"Load\"))]",
            "Kernel Nodes": "[.[] | select(.name? | contains(\"Kernel\"))]",
            "Gaussian Nodes": "[.[] | select(.name? | contains(\"Gaussian\"))]",
            "Logical Nodes": "[.[] | select(.name? | contains(\"Logical\"))]",
            "Miscellaneous style": "[.[] | select(((.style? == \"miscellaneous\") or (.style? | index(\"miscellaneous\"))))]",
            "Complex query": "[.[] | select((.tag? == \"custom\") and (.name | contains(\"Video\")) and ((.style? | if type == \"array\" then . else [.] end) | index(\"miscellaneous\")))]"
        },
        "tag": "custom"
    }
}
